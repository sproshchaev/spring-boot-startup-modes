<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>demo</groupId>
    <artifactId>startup-modes</artifactId>
    <version>1.0.0</version>
    <name>startup-modes</name>
    <description>One Spring Boot service started five ways</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- CRaC API: no-op on a regular JDK, active on a CRaC-enabled JDK -->
        <dependency>
            <groupId>org.crac</groupId>
            <artifactId>crac</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Adds to the native profile of spring-boot-starter-parent: keeps org.crac off the runtime
            classpath of the native image. With org.crac present Spring Boot registers a Hikari
            checkpoint lifecycle that reads pool internals by reflection and fails at native startup.
            After a -Pnative build target/app.jar has no org.crac either: run.sh extracts the jar for
            the JVM modes before the native build.
        -->
        <profile>
            <id>native</id>
            <dependencies>
                <dependency>
                    <groupId>org.crac</groupId>
                    <artifactId>crac</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <finalName>app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <configuration>
                    <!-- default is ${project.artifactId}; bench.py expects target/app -->
                    <imageName>app</imageName>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
